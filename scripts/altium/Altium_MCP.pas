            While Obj <> Nil Do
            Begin
                Try
                    Inc(Total);
                    Power := Obj;
                    Loc := Power.GetState_Location;
                    LX := Loc.X;
                    LY := Loc.Y;
                    NetName := '';
                    Try NetName := Power.Text; Except End;

                    OnWire := False;
                    SpatialIter := Sheet.SchIterator_Create;
                    If SpatialIter <> Nil Then
                    Begin
                        Try
                            SpatialIter.AddFilter_ObjectSet(MkSet(eWire));
